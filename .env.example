# Simulation is the default. Connected mode requires a separate persistent database.
PORT=4310
DATABASE_PATH=workspace/orders.sqlite
HOST=127.0.0.1
EXECUTION_MODE=simulation
# For connected deployment, use HTTPS at the hosting edge and a persistent /data volume.
# Do not share these secrets or use VITE_ environment variables for them.
# PUBLIC_BASE_URL=https://your-demo.example/
# DEMO_ACCESS_PASSWORD=<at least 16 random characters; HTTP Basic username is demo>
# ZAPIER_RECEIPT_TOKEN=<at least 32 random characters>
# ZAPIER_CREATE_TASK_HOOK=https://hooks.zapier.com/hooks/catch/...
# ZAPIER_UPDATE_TASK_HOOK=https://hooks.zapier.com/hooks/catch/...
# ZAPIER_NOTIFY_HOOK=https://hooks.zapier.com/hooks/catch/...
# ZAPIER_DIGEST_HOOK=https://hooks.zapier.com/hooks/catch/...
# Optional daily digest, once per local date; startup catches up today's run only.
# DAILY_DIGEST_TIME=09:00
# DAILY_DIGEST_TIME_ZONE=Asia/Shanghai
